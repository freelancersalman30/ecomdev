<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Disable LiteSpeed cache for dynamic forms/sessions
    <IfModule LiteSpeed>
        CacheDisable
    </IfModule>

    RewriteEngine On

    # Block direct web access to sensitive environment, git, and configuration files
    RewriteRule ^\.env - [F,L,NC]
    RewriteRule ^\.git - [F,L,NC]
    RewriteRule ^composer\.(json|lock)$ - [F,L,NC]
    RewriteRule ^package\.(json|lock)$ - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|tests)/ - [F,L,NC]
    RewriteRule ^storage/(app|framework|logs)/ - [F,L,NC]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests Through /public Directory if not already in /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/$1 [L]
    RewriteRule ^$ public/ [L]
</IfModule>
