# ==============================================================================
# DREAMERS PCB - PRODUCTION ENVIRONMENT CONFIGURATION FOR SUBDOMAIN DEPLOYMENT
# ==============================================================================
# Copy this file as '.env' on your live server / cPanel File Manager:
# e.g.: cp .env.production.example .env
# ==============================================================================

APP_NAME="DREAMERS PCB"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://subdomain.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# 🗄️ DATABASE CONFIGURATION (cPanel MySQL)
# ------------------------------------------------------------------------------
# In cPanel, create a database and user via "MySQL Database Wizard"
# Ensure ALL PRIVILEGES are granted to the user on this database.
# Note: cPanel prefixes database names with your cPanel username (e.g. cpaneluser_ecom)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yourusername_dbname
DB_USERNAME=yourusername_dbuser
DB_PASSWORD=your_secure_password

# ------------------------------------------------------------------------------
# 🍪 SESSION & COOKIE CONFIGURATION
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# ------------------------------------------------------------------------------
# ⚡ CACHING, FILESYSTEM & QUEUE
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# ------------------------------------------------------------------------------
# ✉️ SMTP / EMAIL CONFIGURATION (cPanel Webmail or Brevo / SendGrid / Gmail)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=noreply@yourdomain.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="noreply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# 📦 ASSET & VITE CONFIGURATION
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
